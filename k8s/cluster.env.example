# Copy to k8s.local/cluster.env (git-ignored) and fill in for your cluster; scripts/render-manifests.sh reads it.
MURRAY_NAMESPACE=murray
MURRAY_IMAGE=registry.example.com/murray:0.1.0
MURRAY_HOST=murray.example.com
STORAGE_CLASS=standard
CLUSTER_ISSUER=my-cluster-issuer
PULL_SECRET=my-pull-secret
INGRESS_NAMESPACE=ingress-nginx
MURRAY_AUTOSTART=full
