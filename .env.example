# Copy to .env (never commit it) or export these in your shell. Only GEMINI_API_KEY is required.
GEMINI_API_KEY=

# Bearer token for the control panel (start upbringing, run the eval, reset). Generate: openssl rand -hex 24
MURRAY_ADMIN_TOKEN=

# Where SQLite and renders live (a persistent volume in Kubernetes).
MURRAY_DATA_DIR=/data

# off | quick | full : what the app does on first boot when the database is empty.
MURRAY_AUTOSTART=full

# Several keys are supported: GEMINI_API_KEY_1, GEMINI_API_KEY_2, ... Each conversation stays on one key.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# A label for the operator's usage page: which Google account these keys bill.
GEMINI_ACCOUNT=

# The runaway guard (USD). These never slow normal work; they stop a loop gone wrong from spending everything.
MURRAY_BREAKER_USD_PER_10MIN=30
MURRAY_BREAKER_CALLS_PER_10MIN=2500
MURRAY_BREAKER_USD_PER_DAY=300
MURRAY_BREAKER_PUBLIC_USD_PER_DAY=100
# Optional hard caps; 0 = off.
MURRAY_BUILD_BUDGET_USD=0
MURRAY_PUBLIC_DAILY_CAP_USD=0
MURRAY_SPEND_RATE_USD_PER_10MIN=0

# URL of the sandbox service that runs model-written code. The app refuses to run with a key and no sandbox URL.
MURRAY_SANDBOX_URL=http://murray-sandbox:8100
